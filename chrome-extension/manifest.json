{
  "manifest_version": 3,
  "name": "Meshy To STL",
  "version": "0.2.1",
  "description": "Finds .meshy files in the current tab and converts them to STL, OBJ, or GLB.",
  "action": {
    "default_title": "Meshy To STL",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-downloads; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
